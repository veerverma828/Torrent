# Port the Express server listens on
PORT=5000

# Trakt.tv API app credentials (https://trakt.tv/oauth/applications)
# Required for the /trakt/* device-auth and proxy routes.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Jackett instance API key, used by /search
JACKETT_API_KEY=

# Real-Debrid API key, used by /get-files and /generate-link
REAL_DEBRID_API_KEY=

# Shared admin code gating Real-Debrid routes (/get-files, /generate-link, /verify-rd)
RD_ADMIN_CODE=

# Torbox API key, used by /get-files and /generate-link
TORBOX_API_KEY=
